create table catalogos.productos (
    id_producto serial primary key,
    codigo varchar(50) not null,
    nombre varchar(100) not null,
    descripcion varchar(120) not null,
    precio numeric(10,2) not null,
    stock integer not null,
	fecha_creacion date not null default current_date,
    id_categoria integer not null,
    id_marca integer not null,
    estado smallint not null default 1,

    constraint fk_id_categoria foreign key (id_categoria) references catalogos.categorias(id_categoria),
    constraint fk_id_marca foreign key (id_marca) references catalogos.marcas(id_marca),
	constraint chk_estadoProducto check (estado in (0,1)),
	constraint chk_producto_precio check ( precio > 0),
	constraint chk_producto_stock check ( stock > 0)



);

